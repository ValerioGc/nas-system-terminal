{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "vite": ["./node_modules/vite/dist/node/index.d.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.*", "vitest.config.*", "playwright.config.*", "eslint.config.*"]
}
